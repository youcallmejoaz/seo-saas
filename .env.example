# --- App -------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generated client sites are served at <subdomain>.<ROOT_DOMAIN> (e.g. sites.youragency.com
# with a wildcard DNS record). Locally, *.localhost works in Chromium and Firefox.
ROOT_DOMAIN=localhost:3000

# --- Supabase (from `pnpm supabase start` locally, or your project's API settings) -----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Google Gemini) ----------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey. Without a key the app runs in mock mode.
GEMINI_API_KEY=
# Planning/orchestration vs. bulk copywriting. Run `pnpm ai:check` to confirm the names
# your key can use, then adjust.
LLM_MODEL_PLANNER=gemini-2.5-pro
LLM_MODEL_FAST=gemini-2.5-flash
# 1 = deterministic mock output (tests/CI/demos), 0 = call Gemini.
AI_MOCK=0
# Optional: USD per 1M tokens by model prefix, for cost tracking and budget enforcement.
# Leave empty on the free tier (cost shows as $0; daily request caps still apply).
# AI_PRICES_JSON={"gemini-2.5-pro":{"input":1.25,"output":10},"gemini-2.5-flash":{"input":0.3,"output":2.5}}

# --- Security ----------------------------------------------------------------------------
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts OAuth tokens at rest.
ENCRYPTION_KEY=

# --- Background jobs (Inngest) --------------------------------------------------------
# Local: run `pnpm inngest:dev` and set INNGEST_DEV=1. Production: keys from Inngest Cloud.
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- Google Search Console + GA4 (OAuth client, "Web application") -------------------
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: raises PageSpeed Insights quota.
PAGESPEED_API_KEY=

# --- Optional providers ----------------------------------------------------------------
# Real search volumes + SERP rank tracking (otherwise Search Console + labelled estimates).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Custom domains for client sites (otherwise DNS instructions are shown for manual setup).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Subscription status per client (webhook: /api/stripe/webhook, subscription.metadata.client_id).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
